<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />

    <!-- Node.js handler -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Rewrite rules -->
    <rewrite>
      <rules>
        <!-- ✅ Allow static uploads (do not rewrite) -->
        <rule name="StaticUploads" stopProcessing="true">
          <match url="^uploads/(.*)$" />
          <action type="None" />
        </rule>

        <!-- Serve frontend files from the build directory. -->
        <rule name="BuildFiles" stopProcessing="true">
          <match url="^(?!api(?:/|$))(?!build/)(.*)$" />
          <conditions>
            <add
              input="{APPL_PHYSICAL_PATH}build\{R:1}"
              matchType="IsFile"
            />
          </conditions>
          <action type="Rewrite" url="build/{R:1}" />
        </rule>

        <!-- Send API requests to Node.js. -->
        <rule name="NodeAPI" stopProcessing="true">
          <match url="^api(?:/.*)?$" />
          <action type="Rewrite" url="server.js" />
        </rule>

        <!-- Route frontend paths such as /lucky-draw to the React app. -->
        <rule name="FrontendRoutes" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="build/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- Debugging -->
    <iisnode loggingEnabled="true" devErrorsEnabled="true" />

  </system.webServer>
</configuration>
